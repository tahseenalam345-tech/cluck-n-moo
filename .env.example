# Cluck N Moo (CNM) - Environment Configuration Template
# Copy this file to .env.local for local development.
# WARNING: NEVER commit .env or .env.local containing real credentials to version control.

# Authentication Secret
JWT_SECRET=your_jwt_secret_min_32_characters_here

# Cloudinary Media Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Client-Side Public Variables (Exposed to browser)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
